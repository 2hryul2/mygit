# mygit runtime configuration
# /etc/mygit/mygit.env 로 배치됨. systemd EnvironmentFile 로 로드.

# 서비스 바인드 포트
MYGIT_PORT=8000

# Git bare 리포 저장 루트
MYGIT_REPOS_ROOT=/var/lib/mygit/repos

# 사용자 인증 파일 (pbkdf2_sha256 해시 저장)
MYGIT_AUTH_FILE=/etc/mygit/users.json

# 익명 접근 정책 (기본: 전체 차단)
MYGIT_ALLOW_ANONYMOUS_READ=false
MYGIT_ALLOW_ANONYMOUS_WRITE=false
